{
  "manifest_version": 3,
  "name": "Guardian for Chrome",
  "version": "0.2.0",
  "description": "Puts tabs you are done with to sleep, and parks tabs you have not touched in days into a bookmark folder. Nothing is lost.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "bookmarks"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Guardian",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "options.html",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}

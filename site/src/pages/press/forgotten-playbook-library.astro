---
import Base from '../../layouts/Base.astro';
import { FORGOTTEN_PLAYBOOK, SERIES_PRINCIPLE, SERIES_NOTE } from '../../press';

// Every volume's copy is the series' own catalogue wording. See src/press.ts.
const anyLive = FORGOTTEN_PLAYBOOK.some((v) => v.url);
---

<Base
  title="The Forgotten Playbook Library"
  description="Six volumes from Imagination Applied Press that recover overlooked public-domain ideas and rebuild them for modern families, educators, facilitators and communities."
  path="/press/forgotten-playbook-library/"
>
  <section class="wrap page-head">
    <p class="eyebrow">Imagination Applied Press</p>
    <h1>The Forgotten Playbook Library</h1>
    <p class="lede">
      Six volumes for people running a room. Choose the next one by the work in front of
      you.
    </p>
  </section>

  <section class="wrap page-body">
    <p class="pull">{SERIES_PRINCIPLE}</p>

    {
      !anyLive && (
        <div class="notice">
          <strong>Publishing shortly.</strong> All six volumes are finished and through
          production. This page lists them so you can see what is coming; purchase links
          appear here as each volume goes on sale.
        </div>
      )
    }

    <ol class="volumes">
      {
        FORGOTTEN_PLAYBOOK.map((v) => (
          <li class="volume">
            <p class="volume-no">Volume {v.volume}</p>
            <h2>
              {v.url ? <a href={v.url}>{v.title}</a> : v.title}
            </h2>
            <p class="volume-sub">{v.subtitle}</p>
            <p>{v.chooseWhen}</p>
            <p class="volume-meta">{v.pages} pages · paperback and Kindle</p>
          </li>
        ))
      }
    </ol>

    <div class="section-rule">
      <h2>Where these come from</h2>
      <p>{SERIES_NOTE}</p>
      <p>
        Each volume starts from material that already worked once and was left behind—
        public-domain games, crafts, rituals and methods—and rebuilds it for how people
        actually live and work now. The books are written for the adult running the
        activity: a clear setup, small steps, a real choice about how to adapt it, and a
        prompt to notice what happened and adjust.
      </p>
      <p>
        Accessibility is treated as a route into the activity rather than an
        accommodation bolted on afterwards, and each volume is explicit about what it
        does not claim to teach.
      </p>
      <div class="actions">
        <a class="btn btn-secondary" href="/press/">More from the Press</a>
        <a class="btn btn-secondary" href="/contact/">Ask about bulk or institutional use</a>
      </div>
    </div>
  </section>
</Base>

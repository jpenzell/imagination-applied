---
import Base from '../../layouts/Base.astro';
import { SERIES } from '../../press';
export function getStaticPaths() { return SERIES.map(series => ({params:{series:series.slug},props:{series}})); }
const { series } = Astro.props;
const slug = series.slug === 'forgotten-playbook-library' ? 'forgotten-playbook' : series.slug === 'the-past-tests-you' ? 'past-tests-you' : series.slug;
const url = `https://press.imaginationapplied.ai/collections/${slug}/`;
---
<Base title={series.name} description={series.tagline} path={`/press/${series.slug}/`} noindex>
<section class="wrap page-head"><p class="eyebrow">Imagination Applied Press</p><h1>{series.name}</h1><p class="lede">{series.tagline}</p><p>The current catalog and purchase links are in the Press store.</p><a class="btn" href={url}>Explore the collection</a></section>
</Base>

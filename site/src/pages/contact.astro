---
import Base from '../layouts/Base.astro';
import { seo, text } from '../lib/content';
import { defaultSeo, defaultText } from '../lib/blocks';
import { SITE } from '../consts';

// This page is fully static HTML. The form is a plain POST to a Cloudflare
// Pages Function -- no client JavaScript, no third-party embed, and the page
// still renders and submits with scripting disabled.

// Editable from the joshpenzell.com admin; falls back to the default above.
const meta = await seo('ia.seo.contact.v2', defaultSeo('ia.seo.contact.v2'));
// Editable from the admin too, so the address can change without a deploy.
const contactEmail = await text('ia.global.contactEmail', defaultText('ia.global.contactEmail'));
---

<Base
  title={meta.title}
  description={meta.description}
  path="/contact/"
>
  <section class="wrap page-head">
    <p class="eyebrow">Contact</p>
    <h1>Start a conversation</h1>
    <p class="lede">
      The most useful first message is not a brief. It is the thing you are actually
      stuck on.
    </p>
  </section>

  <section class="wrap page-body">
    <p>
      Tell us what is happening, who it affects, and what you have already tried. If we
      are not the right people, we will say so and point you somewhere better.
    </p>
    <p class="muted">
      Booking Josh for a stage? That goes through{' '}
      <a href={`${SITE.founderSite}/speaking`}>joshpenzell.com</a>. Prefer plain email?
      <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
    </p>

    <form class="form" method="POST" action="/api/contact" style="margin-top:2rem">
      <input type="hidden" name="utm_source" />
      <input type="hidden" name="utm_medium" />
      <input type="hidden" name="utm_campaign" />
      <input type="hidden" name="utm_content" />
      <input type="hidden" name="landingPage" value="/contact/" />
      <div class="field">
        <label for="name">Your name</label>
        <input id="name" name="name" type="text" required autocomplete="name" />
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email" />
      </div>

      <div class="field">
        <label for="organization">Organization</label>
        <input id="organization" name="organization" type="text" autocomplete="organization" />
      </div>

      <div class="field">
        <label for="topic">What is this about?</label>
        <select id="topic" name="topic" required>
          <option value="" disabled selected>Choose a starting point</option>
          <option value="learning-design">Learning Experience Design &amp; Advisory</option>
          <option value="rehearsal-day">One-Day AI Work Lab</option>
          <option value="rehearsal-30">30-Day AI Work Rehearsal</option>
          <option value="practice">Rehearsal Practice</option>
          <option value="advisory">Transformation Advisory</option>
          <option value="speaking">A keynote or workshop</option>
          <option value="research">The research</option>
          <option value="other">Something else</option>
        </select>
      </div>

      <div class="field">
        <label for="message">What are you stuck on?</label>
        <p class="hint">
          Tell us the workflow, who is involved and what needs to change. Please leave out confidential information.
        </p>
        <textarea id="message" name="message" required></textarea>
      </div>

      <!-- Honeypot. Hidden from people, irresistible to naive bots. -->
      <div class="hp" aria-hidden="true">
        <label for="company_website">Do not fill this in</label>
        <input id="company_website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button class="btn" type="submit">Send</button>
      <p class="muted" style="font-size:0.82rem;margin-top:1rem">
        We use your message to reply and manage your inquiry. Campaign labels help us understand how people find our services.
      </p>
    </form>
  </section>
  <script>
    const topic = new URLSearchParams(location.search).get('topic');
    const select = document.querySelector<HTMLSelectElement>('#topic');
    if (select && Array.from(select.options).some(option => option.value === topic)) select.value = topic!;
  </script>
</Base>

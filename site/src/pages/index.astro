---
import Base from '../layouts/Base.astro';
import { seo, text, richtext, list } from '../lib/content';
import { defaultSeo, defaultText, DEFAULTS } from '../lib/blocks';
import { SITE, PRACTICE, PUBLICATIONS } from '../consts';

const pub = PUBLICATIONS[0];

// All editable from the Site Content tab of the joshpenzell.com admin.
// Use a new key for the Artistic Intelligence positioning so a legacy saved
// homepage SEO row cannot silently override the launch title and description.
const meta = await seo(
  'ia.seo.home.artistic-intelligence',
  defaultSeo('ia.seo.home.artistic-intelligence')
);
const headline = await text('ia.home.hero.headline', defaultText('ia.home.hero.headline'));
const lede = await text('ia.home.hero.lede', defaultText('ia.home.hero.lede'));
const tensionHeading = await text(
  'ia.home.tension.heading',
  defaultText('ia.home.tension.heading')
);
const tensionBody = await richtext(
  'ia.home.tension.body',
  defaultText('ia.home.tension.body')
);
const researchBlurb = await text('ia.home.research.blurb', defaultText('ia.home.research.blurb'));

interface Door {
  title: string;
  href: string;
  for: string;
  outcome: string;
}
const doors = await list<Door>('ia.doors.items', DEFAULTS['ia.doors.items'] as Door[]);

// The hero's last word carries the whole brand ("...Direct."), so it is set in
// the accent. Split rather than hard-code, so an edited headline still works.
const words = headline.trim().split(/\s+/);
const headLead = words.slice(0, -1).join(' ');
const headTurn = words.at(-1) ?? '';

// The entity graph. joshpenzell.com is the person, this is the company; saying
// so explicitly in both directions is what lets a search engine treat them as
// one body of work rather than two unrelated domains. This is the machine-
// readable half of the cross-linking; the visible half is the footer and the
// "Who is behind this" section.
const orgId = `${SITE.origin}/#organization`;
const personId = `${SITE.founderSite}/#person`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: SITE.name,
      url: SITE.origin,
      description: meta.description,
      slogan: SITE.hero,
      founder: { '@id': personId },
      employee: { '@id': personId },
      sameAs: [SITE.linkedin, SITE.founderSite],
      knowsAbout: [
        'Artistic Intelligence',
        'Creativity',
        'Imagination',
        'Human judgment',
        'TheaterThink',
        'Prototyping',
        'Capability building',
        'Organizational change',
        'Leadership development',
        'Artificial intelligence',
      ],
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: SITE.founder,
      url: SITE.founderSite,
      jobTitle: 'Keynote speaker, advisor, and author',
      worksFor: { '@id': orgId },
      founderOf: { '@id': orgId },
      // sameAs is an identity claim, so every entry must be a URL that has
      // been confirmed to exist. Josh's personal LinkedIn profile URL is not
      // in here because LinkedIn returns 999 to any non-browser request, so it
      // could not be verified -- and an unverified sameAs actively misinforms
      // a crawler. Add it once the exact profile URL is confirmed.
      sameAs: [SITE.founderSite],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.origin}/#website`,
      url: SITE.origin,
      name: SITE.name,
      publisher: { '@id': orgId },
      inLanguage: 'en',
    },
  ],
};
---

<Base
  title={meta.title}
  description={meta.description}
  path="/"
  jsonLd={jsonLd}
>
  <section class="wrap hero">
    {/* The mark's own gesture, drawn once: an idea leaving the head and going
        somewhere. Decorative, so it is hidden from assistive tech. */}
    <svg class="hero-path" viewBox="0 0 520 300" fill="none" aria-hidden="true">
      <path
        d="M8 286C96 250 176 196 246 132 296 86 344 44 404 24"
        stroke="var(--teal)"
        stroke-width="2"
        stroke-dasharray="7 9"
        stroke-linecap="round"
        opacity="0.55"
      />
      <path d="M498 6 396 70l28 10z" fill="var(--magenta)" />
      <path d="m498 6-74 74 11 40z" fill="var(--orange)" />
    </svg>

    <p class="eyebrow">{SITE.tagline}</p>
    <h1>{headLead} <span class="turn">{headTurn}</span></h1>
    <p class="lede">{lede}</p>
    <div class="actions">
      <a class="btn" href="/contact/">Start a conversation</a>
      <a class="btn btn-secondary" href="/how-we-work/">See how we work</a>
    </div>
  </section>

  <section class="wrap section-rule">
    <h2>{tensionHeading}</h2>
    <div class="prose" set:html={tensionBody} />
    <p class="pull">Artistic Intelligence is what we use when the answer is not waiting to be found—it has to be made.</p>
  </section>

  <section class="wrap section-rule">
    <h2>Four ways to work together</h2>
    <p class="muted">
      See it. Rehearse it. Build it. Own it. Start where the work is now.
    </p>
    <ul class="cards">
      {
        doors.map((door) => (
          <li class="card card-link">
            <h3><a href={door.href}>{door.title}</a></h3>
            <p>{door.for}</p>
            <p class="outcome">
              <strong>Outcome</strong>
              {door.outcome}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section-rule">
    <p class="eyebrow">A common engagement path</p>
    <h2>From a room that can see it to a team that can own it</h2>
    <p class="muted">
      These are not four competing products. They are moves that can stand alone or build
      into one practical journey.
    </p>
    <ol class="moves">
      <li class="move">
        <h3>Kick off</h3>
        <p class="move-sub">Keynote or workshop</p>
        <p>Create a shared language and make the real opportunity visible.</p>
      </li>
      <li class="move">
        <h3>Work it</h3>
        <p class="move-sub">Ongoing jams</p>
        <p>Use real decisions and workflows to practice the moves together.</p>
      </li>
      <li class="move">
        <h3>Build proof</h3>
        <p class="move-sub">Prototype support</p>
        <p>Make something concrete enough to test, improve, and decide what deserves to scale.</p>
      </li>
      <li class="move">
        <h3>Transfer it</h3>
        <p class="move-sub">Internal capability</p>
        <p>Leave the team with artifacts, routines, and the ability to continue without us.</p>
      </li>
    </ol>
  </section>

  <section class="wrap section-rule">
    <h2>The method: direct, cast, rehearse</h2>
    <p>
      Our practice is called TheaterThink. It is not a metaphor we decorate the work with.
      It is how the work is actually run: three moves, in order.
    </p>
    <ol class="moves">
      {
        PRACTICE.map((step) => (
          <li class="move">
            <h3>{step.name}</h3>
            <p class="move-sub">{step.subtitle}</p>
            <p>{step.oneLiner}</p>
          </li>
        ))
      }
    </ol>
    <p style="margin-top:1.5rem">
      <a href="/how-we-work/">How we work, in detail →</a>
    </p>
  </section>

  <section class="wrap section-rule">
    <h2>What we actually make</h2>
    <p>
      Sometimes the work is a decision. Sometimes it needs to become a thing people can
      touch, try, and improve. We build the proof alongside the team, then transfer the
      practice rather than creating permanent dependence on us.
    </p>
    <ul class="cards artifact-cards">
      <li class="card">
        <h3>Learning experiences</h3>
        <p>Programs, labs, and interactive environments that change what people do—not only what they complete.</p>
      </li>
      <li class="card">
        <h3>Decision tools</h3>
        <p>Working aids, dashboards, and prototypes that make a consequential choice easier to see and test.</p>
      </li>
      <li class="card">
        <h3>Workflows and automations</h3>
        <p>Practical systems that put technology inside the work, with human judgment kept where it belongs.</p>
      </li>
      <li class="card">
        <h3>Internal practice</h3>
        <p>Facilitation guides, coaching, and team routines that let the capability keep moving after we leave.</p>
      </li>
    </ul>
  </section>

  <section class="wrap section-rule">
    <p class="eyebrow">Imagination Applied Lab</p>
    <h2>Some questions are better rehearsed than explained.</h2>
    <p>
      Use interactive tools to compare technology impacts, discover your Director Type,
      rehearse a human–AI creative team, or question the ideas behind the work.
    </p>
    <p style="margin-top:1.5rem">
      <a class="btn btn-secondary" href="/lab/">Enter the Lab →</a>
    </p>
  </section>

  <section class="wrap section-rule">
    <div class="evidence-grid">
      <figure class="evidence-photo">
        <img
          src="/images/innovateqa-live-workshop.jpg"
          alt="Josh Penzell facilitating an audience exercise at InnovateQA 2026"
          loading="lazy"
        />
        <figcaption>Founder-led work in the room · InnovateQA 2026 · Photo courtesy of InnovateQA</figcaption>
      </figure>

      <div class="evidence-copy">
        <p class="eyebrow">Proof behind the practice</p>
        <h2>The company is new. The practice isn't.</h2>
        <p>
          Imagination Applied is the company around work Josh has been developing in
          keynotes, labs, team sessions, and live builds. These publication-cleared
          responses show what organizations have already experienced.
        </p>

        <blockquote class="evidence-quote">
          <p>
            “Josh led two sessions at the Special Olympics Leadership Academy, and both
            were the highest-rated of the program per participants' feedback. He made AI
            feel practical and human for our team. We can't wait to work with him again.”
          </p>
          <footer>
            <strong>Svetlana Fenichel</strong>
            <span>Sr. Director, Learning &amp; Organizational Development · Special Olympics</span>
          </footer>
        </blockquote>

        <blockquote class="evidence-quote">
          <p>
            “The team continued to rave about it after you left and left the meeting
            energized to think about AI differently and put Copilot to work!”
          </p>
          <footer>
            <strong>A.J. Koenig</strong>
            <span>Delicato Family Wines</span>
          </footer>
        </blockquote>

        <div class="actions">
          <a class="btn" href="/keynotes-and-workshops/">Bring it into the room</a>
          <a class="btn btn-secondary" href="/contact/">Start a conversation</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section-rule">
    <h2>We publish what we find</h2>
    <p>{researchBlurb}</p>
    <div class="card" style="margin-top:1.5rem;max-width:38rem">
      <p class="eyebrow">{pub.series}</p>
      <h3 style="margin-top:0">
        <a href={`/publications/${pub.slug}/`}>{pub.title}</a>
      </h3>
      <p>{pub.description}</p>
      <p class="outcome">
        <strong>Read</strong>
        Full analysis, figures, reproducible code, and the strongest counterargument.
      </p>
    </div>
  </section>

  <section class="wrap section-rule">
    <h2>Who is behind this</h2>
    <p>
      Imagination Applied was founded by <a href={SITE.founderSite}>Josh Penzell</a>—keynote
      speaker, advisor, and theater director by training. He is the forthcoming author of{' '}
      <em>Artistic Intelligence</em>, and the public voice of this work.
    </p>
    <p>
      If you are here to book Josh for a stage or explore the ideas, that lives on{' '}
      <a href={SITE.founderSite}>joshpenzell.com</a>. If you are here to bring the work
      into your organization, you are in the right place.
    </p>
    <div class="actions">
      <a class="btn" href="/contact/">Start a conversation</a>
      <a class="btn btn-secondary" href="/about/">About the company</a>
    </div>
  </section>
</Base>

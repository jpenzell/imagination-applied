---
import Base from '../layouts/Base.astro';
import { seo } from '../lib/content';
import { defaultSeo } from '../lib/blocks';
import { SITE, DOORS } from '../consts';

const door = DOORS.find(door => door.title === 'Keynotes')!;

// Canonical talk titles and subtitles: Brand Guide section 7, "The Public Talk
// Portfolio". Titles are fixed -- older names are variants, not products.
const TALKS = [
  {
    title: 'Rehearsing the Future',
    subtitle: 'Artistic Intelligence for the Age of AI',
    role: 'Flagship conceptual keynote',
    promise:
      'AI has changed the script. This keynote shows leaders how to create direction, align an ensemble, and rehearse what comes next.',
    when: 'When the event needs the full worldview, as an opening or closing keynote.',
  },
  {
    title: 'Casting for Creativity',
    subtitle: 'How Great Teams Are Built, Not Born',
    role: 'Interactive creativity keynote or workshop',
    promise:
      'A director’s approach to composing teams for imagination, productive difference, and breakthrough work instead of hoping for chemistry.',
    when: 'When leaders need a practical language for how creativity happens between people.',
  },
  {
    title: 'Human Caffeine',
    subtitle: 'The Energy Behind the Presentation',
    role: 'Communication and presence keynote or workshop',
    promise:
      'A lively, practical session about attention, sensory design, and the human energy that makes an idea move.',
    when: 'When presenters, facilitators, or leaders need the room to lean in and act.',
  },
];

// Editable from the joshpenzell.com admin; falls back to the default above.
const meta = await seo('ia.seo.keynotes.v2', defaultSeo('ia.seo.keynotes.v2'));
---

<Base
  title={meta.title}
  description={meta.description}
  path="/keynotes-and-workshops/"
>
  <section class="wrap page-head">
    <p class="eyebrow">Ways to work together</p>
    <h1>Keynotes and workshops</h1>
    <p class="lede">{door.for}</p>
  </section>

  <section class="wrap page-body">
    <p>
      <strong>Outcome.</strong>
      {door.outcome}
    </p>
    <p>
      Josh does not give a lecture about creativity. He makes the room part of the work.
      Depending on the topic, the audience may direct AI live, cast an ensemble, diagnose
      the energy of a presentation, or rehearse a consequential choice. The argument moves
      because the room moves.
    </p>

    <div class="section-rule">
      <h2>The portfolio</h2>
      <ul class="cards">
        {
          TALKS.map((talk) => (
            <li class="card">
              <p class="eyebrow">{talk.role}</p>
              <h3 style="margin-top:0">{talk.title}</h3>
              <p class="muted">{talk.subtitle}</p>
              <p>{talk.promise}</p>
              <p class="outcome">
                <strong>Best fit</strong>
                {talk.when}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="muted" style="margin-top:1.25rem">
        Industry-specific sessions are built as variants of these talks rather than as
        separate programs.
      </p>
    </div>

    <div class="section-rule">
      <h2>Bring the idea into the work</h2>
      <p>A keynote creates shared language. The Rehearsal Room gives a team the chance to use it on a real workflow. Choose a One-Day AI Work Lab or a 30-Day AI Work Rehearsal, then build an ongoing practice from what the team learns.</p>
      <p><a href="/rehearsal-room/">Explore The Rehearsal Room →</a></p>
    </div>

    <div class="section-rule">
      <h2>Booking</h2>
      <p>
        Speaking is booked through Josh directly. His speaker page carries availability,
        reel, and the full stage history.
      </p>
      <div class="actions">
        <a class="btn" href={`${SITE.founderSite}/speaking`}>Bring Josh to your stage</a>
        <a class="btn btn-secondary" href="/contact/">Ask about a workshop</a>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../../../layouts/Base.astro';
import { PUBLICATIONS, SITE } from '../../../consts';
// The 2026 brief is staged by prebuild; the 2025 release remains a frozen archive.
import { Content } from '../../../content/adoption-without-confidence.md';

const pub = PUBLICATIONS[0];
const base = `/publications/${pub.slug}`;
const pageUrl = new URL(`${base}/`, SITE.origin).href;

const DOWNLOADS = [
  { href: `${base}/executive-brief-2026.pdf`, label: '2026 executive brief (PDF)' },
  { href: `${base}/executive-brief-2026.docx`, label: '2026 executive brief (Word)' },
  { href: `${base}/carousel-2026.pdf`, label: '2026 slide summary (PDF)' },
];
const ARCHIVE_DOWNLOADS = [
  { href: `${base}/paper.html`, label: '2025 article (HTML)' },
  { href: `${base}/paper.pdf`, label: '2025 article (PDF)' },
  { href: `${base}/paper.docx`, label: '2025 article (Word)' },
  { href: `${base}/open-research-note.pdf`, label: '2025 Open Research Note (PDF)' },
  { href: `${base}/research-report.pdf`, label: '2025 full research report (PDF)' },
  { href: `${base}/executive-brief.pdf`, label: '2025 executive brief (PDF)' },
  { href: `${base}/carousel.pdf`, label: '2025 slide summary (PDF)' },
];

// Citation string is the one in the package README, extended with the live URL.
const citation = `Penzell, J. (2026). ${pub.formalTitle}. Imagination Applied Press, ${pub.series}. ${pub.doi ? `https://doi.org/${pub.doi}` : pageUrl}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: pub.title,
  alternativeHeadline: pub.formalTitle,
  description: pub.description,
  url: pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  datePublished: pub.datePublished,
  dateModified: pub.dateModified,
  inLanguage: 'en',
  version: pub.version,
  isPartOf: { '@type': 'PublicationIssue', name: pub.series },
  author: {
    '@type': 'Person',
    name: pub.author,
    url: SITE.founderSite,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Imagination Applied Press',
    url: SITE.origin,
  },
  license: pub.licenseUrl,
  image: new URL(pub.ogImage, SITE.origin).href,
  codeRepository: pub.researchRepo,
  ...(pub.doi ? { identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: pub.doi } } : {}),
};
---

<Base
  title={pub.ogTitle}
  description={pub.description}
  path={`${base}/`}
  image={pub.ogImage}
  imageAlt="Daily AI use among current users in the 2026 analysis: 54.3% for very unfavorable users and 93.0% for very favorable users."
  ogType="article"
  jsonLd={jsonLd}
>
  <section class="wrap page-head">
    <p class="eyebrow">{pub.series} · Version {pub.version}</p>
    <h1>{pub.title}</h1>
    <p class="lede">{pub.subtitle}</p>
    <p class="muted">
      {pub.author} ·{' '}
      Updated <time datetime={pub.dateModified}>
        {
          new Date(pub.dateModified).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            timeZone: 'UTC',
          })
        }
      </time>
    </p>
    <p class="muted">This revision adds the 2026 survey. The original 2025 release was published August 12, 2026 and remains available below.</p>
  </section>

  <div class="wrap pub-layout">
    <article class="pub-body">
      <Content />
    </article>

    <aside class="sidebar">
      <h2>Read and download</h2>
      <ul>
        {DOWNLOADS.map((d) => <li><a href={d.href}>{d.label}</a></li>)}
      </ul>

      <h2>Reproduce</h2>
      <ul>
        <li><a href={pub.researchRelease}>2026 research release</a></li>
        <li><a href={pub.researchRepo}>Analysis, methods and verification</a></li>
        <li><a href={`${base}/MANIFEST-2026.sha256`}>2026 file manifest (SHA-256)</a></li>
        <li><a href={`${base}/CITATION.cff`}>CITATION.cff</a></li>
      </ul>
      <p class="muted" style="font-size:0.82rem">
        Stack Overflow survey data are not redistributed. The repository documents how to
        obtain the official files and verify their hashes.
      </p>

      <h2>Details</h2>
      <dl>
        <div class="meta-row"><dt>Version</dt><dd>{pub.version}</dd></div>
        <div class="meta-row"><dt>Updated</dt><dd>{pub.dateModified}</dd></div>
        <div class="meta-row"><dt>Licence</dt><dd><a href={pub.licenseUrl}>{pub.license}</a></dd></div>
        <div class="meta-row"><dt>2026 DOI</dt><dd>Not yet assigned</dd></div>
      </dl>

      <h2>2025 release archive</h2>
      <p class="muted">Version 3.1.0, published August 12, 2026. These files and the DOI identify the earlier analysis, before the 2026 survey was added.</p>
      <ul>
        {ARCHIVE_DOWNLOADS.map((d) => <li><a href={d.href}>{d.label}</a></li>)}
        <li><a href={`https://doi.org/${pub.previousVersionDoi}`}>2025 version DOI: {pub.previousVersionDoi}</a></li>
        <li><a href={`${base}/CITATION-2025.cff`}>2025 CITATION.cff</a></li>
        <li><a href={`${base}/MANIFEST.sha256`}>2025 file manifest</a></li>
      </ul>

      <h2>Cite the 2026 revision</h2>
      <p class="citation">{citation}</p>
    </aside>
  </div>

  <section class="wrap">
    <div class="section-rule">
      <h2>Corrections welcome</h2>
      <p>
        This is an open research note. Corrections, replication attempts, and
        methodological criticism are welcome. Material revisions will be documented in the
        repository release notes and reflected in the versioned research note.
      </p>
      <div class="actions">
        <a class="btn btn-secondary" href="/contact/">Get in touch</a>
        <a class="btn btn-secondary" href="/publications/">All research</a>
      </div>
    </div>
  </section>
</Base>
